{
  "name": "linter-config",
  "version": "0.1.0",
  "main": "./dist/linter-config.mjs",
  "dependencies": {
    "eslint": "9.39.2",
    "hermes-eslint": "0.33.0",
    "prettier": "3.7.4"
  },
  "contributes": {
    "commands": [
      {
        "command": "linter-config.format",
        "title": "Linter Config: Format document"
      }
    ],
    "languages": [
      {
        "id": "javascript",
        "extensions": [
          ".cjs",
          ".js",
          ".mjs"
        ]
      },
      {
        "id": "json",
        "extensions": [
          ".json"
        ]
      }
    ]
  },
  "engines": {
    "vscode": "^1.107.0"
  }
}
