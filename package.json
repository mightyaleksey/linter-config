{
  "name": "linter-config",
  "version": "1.0.0",
  "dependencies": {
    "@eslint/config-helpers": "0.7.0",
    "eslint": "10.8.1",
    "eslint-config-standard": "17.1.0",
    "eslint-config-standard-jsx": "11.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "18.3.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.11.0",
    "hermes-eslint": "0.37.0",
    "prettier": "3.9.6"
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.2",
    "vite": "8.2.1"
  },
  "bin": "./src/bin.mjs",
  "engine": {
    "node": ">=22.0.0"
  },
  "exports": {
    "./eslint": "./eslint.config.mjs",
    "./prettier": "./prettier.config.mjs"
  },
  "files": [
    "eslint.config.mjs",
    "prettier.config.mjs",
    "src"
  ],
  "scripts": {
    "build": "vite build --config vscode-extension/vite.config.mjs --emptyOutDir && cd ./vscode-extension && pnpm exec vsce package --allow-missing-repository && code --install-extension linter-config-0.1.0.vsix",
    "format": "node src/bin.mjs -f '**/*.json' 'src/**/*.mjs'",
    "test": "node src/bin.mjs 'src/**/*.mjs' 'tests/*.mjs'"
  }
}
